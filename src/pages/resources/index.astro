---
import { getCollection, type CollectionEntry } from "astro:content";
import ContentCard from "../../components/ContentCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const resources: CollectionEntry<"resources">[] = await getCollection(
  "resources",
  ({ data }: CollectionEntry<"resources">) => !data.draft,
);

resources.sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="资源 | 个人资料库">
  <header class="page-intro">
    <p class="eyebrow">下载</p><h1>资源</h1><p>
      通过 GitHub Releases 直接发布的实用文件。
    </p>
  </header>
  <div class="card-grid">
    {
      resources.map((resource) => (
        <ContentCard
          title={resource.data.title}
          description={resource.data.description}
          href={`${base}resources/${resource.id}`}
          tags={resource.data.tags}
          meta={`${resource.data.category} · v${resource.data.version}`}
        />
      ))
    }
  </div>
</BaseLayout>
