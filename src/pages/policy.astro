---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Policy and takedown | Personal Library">
  <article class="detail-layout">
    <header class="page-intro">
      <p class="eyebrow">Site policy</p>
      <h1>Policy and takedown</h1>
      <p>Simple rules for a small, static public library.</p>
    </header>
    <h2>Privacy</h2>
    <p>
      No user data is collected. This site has no accounts, forms, analytics, or
      privacy-invasive scripts.
    </p>
    <h2>Copyright and takedown</h2>
    <p>
      Resources must be files I own or files released under an applicable
      open-source licence. If you believe a page or download infringes your
      rights, email the repository owner with the URL, the work concerned, and
      your contact details. I will review a valid takedown request promptly.
    </p>
  </article>
</BaseLayout>
