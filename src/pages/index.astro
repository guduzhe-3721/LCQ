---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentCard from "../components/ContentCard.astro";

const title = "个人资料库";
const [articles, resources]: [
  CollectionEntry<"articles">[],
  CollectionEntry<"resources">[],
] = await Promise.all([
  getCollection(
    "articles",
    ({ data }: CollectionEntry<"articles">) => !data.draft,
  ),
  getCollection(
    "resources",
    ({ data }: CollectionEntry<"resources">) => !data.draft,
  ),
]);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={title}>
  <section class="hero">
    <p class="eyebrow">由 Markdown 驱动的个人发布</p>
    <h1>个人资料库</h1>
    <p>用简洁的静态网站发布文章与实用资源。</p>
  </section>
  <section aria-labelledby="articles-heading">
    <div class="section-heading">
      <h2 id="articles-heading">最新文章</h2>
      <a href={`${base}articles`}>查看全部文章</a>
    </div>
    <div class="card-grid">
      {
        articles
          .sort(
            (a, b) =>
              b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
          )
          .map((article) => (
            <ContentCard
              title={article.data.title}
              description={article.data.description}
              href={`${base}articles/${article.id}`}
              tags={article.data.tags}
              meta={article.data.publishedAt.toLocaleDateString("zh-CN", {
                month: "long",
                day: "numeric",
                year: "numeric",
              })}
            />
          ))
      }
    </div>
  </section>
  <section aria-labelledby="resources-heading">
    <div class="section-heading">
      <h2 id="resources-heading">已发布资源</h2>
      <a href={`${base}resources`}>查看全部资源</a>
    </div>
    <div class="card-grid">
      {
        resources
          .sort(
            (a, b) =>
              b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
          )
          .map((resource) => (
            <ContentCard
              title={resource.data.title}
              description={resource.data.description}
              href={`${base}resources/${resource.id}`}
              tags={resource.data.tags}
              meta={`${resource.data.category} · v${resource.data.version}`}
            />
          ))
      }
    </div>
  </section>
</BaseLayout>
