---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentCard from "../components/ContentCard.astro";

const title = "Personal Library";
const [articles, resources]: [
  CollectionEntry<"articles">[],
  CollectionEntry<"resources">[],
] = await Promise.all([
  getCollection(
    "articles",
    ({ data }: CollectionEntry<"articles">) => !data.draft,
  ),
  getCollection(
    "resources",
    ({ data }: CollectionEntry<"resources">) => !data.draft,
  ),
]);
---

<BaseLayout title={title}>
  <section class="hero">
    <p class="eyebrow">Markdown-powered personal publishing</p>
    <h1>Personal Library</h1>
    <p>Articles and useful resources, published as a simple static site.</p>
  </section>
  <section aria-labelledby="articles-heading">
    <div class="section-heading">
      <h2 id="articles-heading">Latest articles</h2>
      <a href="/articles">View all articles</a>
    </div>
    <div class="card-grid">
      {
        articles
          .sort(
            (a, b) =>
              b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
          )
          .map((article) => (
            <ContentCard
              title={article.data.title}
              description={article.data.description}
              href={`/articles/${article.id}`}
              tags={article.data.tags}
              meta={article.data.publishedAt.toLocaleDateString("en-US", {
                month: "long",
                day: "numeric",
                year: "numeric",
              })}
            />
          ))
      }
    </div>
  </section>
  <section aria-labelledby="resources-heading">
    <div class="section-heading">
      <h2 id="resources-heading">Published resources</h2>
      <a href="/resources">View all resources</a>
    </div>
    <div class="card-grid">
      {
        resources
          .sort(
            (a, b) =>
              b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
          )
          .map((resource) => (
            <ContentCard
              title={resource.data.title}
              description={resource.data.description}
              href={`/resources/${resource.id}`}
              tags={resource.data.tags}
              meta={`${resource.data.category} · v${resource.data.version}`}
            />
          ))
      }
    </div>
  </section>
</BaseLayout>
