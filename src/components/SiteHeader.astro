---
const base = import.meta.env.BASE_URL;
const links = [
  { href: base, label: "首页" },
  { href: `${base}articles`, label: "文章" },
  { href: `${base}resources`, label: "资源" },
  { href: `${base}search`, label: "搜索" },
  { href: `${base}about`, label: "关于本站" },
];
---

<header class="site-header">
  <div class="site-shell header-content">
    <nav aria-label="主导航">
      <ul class="nav-links">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
